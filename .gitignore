# ========================================
# Project Ignore Rules
# ========================================

# Build directories (project + recursive)
Debug/**
Release/**
**/Debug/**
Debug
**/Release/**
**/build/**
**/cmake-build-*/**
build/

# Binary output directories
**/Binaries/**

# Compiled objects and debug symbols
*.o
*.ko
*.obj
*.elf
*.dSYM/

# Firmware and linker outputs
*.srec
*.lst
*.hex
*.bin
*.list
*.map

# Executables and app bundles
*.exe
*.out
*.app
*.i*86
*.x86_64

# Libraries and precompiled headers
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib
*.gch
*.pch

# Dependency and intermediate files
*.ii
*.d
*.su
*.tmp
.fuse*
*.orig

# Logs and local caches
*.log
.cache/
.clangd/

# OS/editor noise
.DS_Store
Thumbs.db
*.swp

# STM32CubeMX and generated metadata
STM32L152-Discovery.elf.launch
.mxproject
.dep/

# IDE/editor settings and launch configs
.metadata
.settings
[Rr]elease
[Dd]ebug
**/Debug/
*.launch
.vs/*
.vscode/*
# STM32CubeIDE / Eclipse Project Files & Launch Configurations
!.project
!.cproject
!.settings/
!*.launch

# Ignore Build folders (recursive)
/[Dd]ebug/
/[Rr]elease/
/**/[Dd]ebug/
/**/[Rr]elease/
/**/build/
/**/cmake-build-*/**

# Ignore Binaries folder outputs
**/Binaries/**

# Toolchain files
*.o
*.obj
*.d
*.su
*.a
*.lib
*.lst

# Firmware and link outputs
*.elf
*.bin
*.hex
*.map
*.srec
*.list

# Temp files
*.i
*.ii

# Logs and caches
*.log
.cache/
.clangd/

# Eclipse workspace metadata & developer-local overrides
.metadata/
*.launch.user

# OS/editor noise
.DS_Store
Thumbs.db
*.swp